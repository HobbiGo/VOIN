import json
from pathlib import Path
from security.pqc_signer import generate_keypair

GENESIS_PATH = Path("genesis.json")
KEYPAIR_SECRET_FILE = Path(".voin_validator_pqc_key.json")


def main():
    if not GENESIS_PATH.exists():
        raise FileNotFoundError("genesis.json tidak ditemukan di direktori saat ini.")

    # 1. Bangkitkan pasangan kunci ML-DSA-44 asli
    # Perhatikan: generate_keypair() mengembalikan (public_key_bytes, private_key_bytes)
    pk_bytes, sk_bytes = generate_keypair()
    pk_hex = pk_bytes.hex()
    sk_hex = sk_bytes.hex()

    # 2. Simpan private key ke file terpisah di luar genesis.json
    # Pastikan nama file ini masuk ke .gitignore dan tidak di-commit ke Git
    KEYPAIR_SECRET_FILE.write_text(
        json.dumps(
            {
                "algorithm": "ML-DSA-44",
                "public_key_hex": pk_hex,
                "private_key_hex": sk_hex,
            },
            indent=2,
        ),
        encoding="utf-8",
    )

    # 3. Baca genesis.json dan isi pk_mldsa_hex pada validator pertama
    genesis_data = json.loads(GENESIS_PATH.read_text(encoding="utf-8"))
    genesis_data["pqc_algorithm"] = "ML-DSA-44"

    validators = genesis_data.get("validators", [])
    if not validators:
        raise ValueError("Daftar validators di genesis.json kosong.")

    validators[0]["pk_mldsa_hex"] = pk_hex

    GENESIS_PATH.write_text(
        json.dumps(genesis_data, indent=2) + "\n",
        encoding="utf-8",
    )

    print("Berhasil memperbarui genesis.json dengan public key ML-DSA-44 asli.")
    print(f"Public key tersimpan di genesis.json (panjang hex: {len(pk_hex)} karakter).")
    print(f"Private key disimpan di {KEYPAIR_SECRET_FILE} (JANGAN upload ke Git/repo).")


if __name__ == "__main__":
    main()
